# ---- QUORUM configuration (all optional; system runs fully with none of these) ----

# SEC EDGAR requires an identifying User-Agent (name + email). Recommended.
SEC_USER_AGENT=QUORUM Research your-email@example.com

# ---- LLM providers (add ONE to upgrade the debate from deterministic to real reasoning) ----
# The router fails over in this order automatically. With none set, the committee
# uses its deterministic agent logic and still runs end-to-end.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Force a specific provider (else "auto"):
# LLM_PROVIDER=gemini

# ---- Optional data upgrades ----
FINNHUB_API_KEY=     # richer, dated company news (point-in-time historical)
FRED_API_KEY=        # macro regime series (rates, CPI, unemployment, curve)

# ---- Behaviour / risk policy (defaults shown) ----
STARTING_CASH=10000
MAX_DEBATE_ROUNDS=3
MAX_POSITION_WEIGHT=0.35
MAX_PORTFOLIO_VOL=0.45
REBALANCE_EVERY_DAYS=5
TRADING_COST_BPS=5
